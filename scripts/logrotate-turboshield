# TurboShield — logrotate untuk audit log WAF (ModSecurity)
# Ini TEMPLATE — jangan pasang mentah-mentah. Placeholder __TS_DIR__ diganti
# otomatis oleh scripts/setup-timezone-logrotate.sh sesuai direktori instalasi
# aktual (bebas dari mana saja, tidak harus /root).
#
# Pasang manual (kalau tak pakai script):
#   sudo sed "s#__TS_DIR__#$(pwd)#g" scripts/logrotate-turboshield > /etc/logrotate.d/turboshield
#   sudo logrotate -v /etc/logrotate.d/turboshield   # tes
#
# Catatan: logrotate TIDAK menerima komentar di ujung baris directive,
# jadi semua penjelasan diletakkan sebagai baris komentar tersendiri.

__TS_DIR__/waf/logs/*.log {
    # rotasi harian, simpan 14 arsip (~2 minggu)
    daily
    rotate 14
    # rotasi lebih awal bila file > 50MB
    maxsize 50M
    # jangan error bila file belum ada; jangan rotasi bila kosong
    missingok
    notifempty
    # gzip arsip lama, tunda 1 siklus (aman utk proses yg masih menulis)
    compress
    delaycompress
    # WAJIB: truncate file asli tanpa restart nginx (ModSecurity pakai fd sama)
    copytruncate
    # nama arsip pakai tanggal: modsec_audit.log-20260727.gz
    dateext
    dateformat -%Y%m%d
    su root root
}
